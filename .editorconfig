root = true

# Reglas globales para todos los archivos
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Configuración específica para C y C++
[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

# Configuración para archivos de construcción y configuración (CMake, JSON, etc.)
[CMakeLists.txt, *.cmake]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 2
